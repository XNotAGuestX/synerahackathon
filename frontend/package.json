{
  "name": "hackathon-synera-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:effects": "node --experimental-strip-types src/domain/effects.check.ts",
    "test:walk": "node --experimental-strip-types src/domain/walk-field.check.ts",
    "test:live": "node --experimental-strip-types src/features/live/position-sync.check.ts",
    "test:voice": "node --experimental-strip-types src/features/voice/vad.check.ts && node --experimental-strip-types src/features/voice/wav.check.ts && node --experimental-strip-types src/features/voice/speech-queue.check.ts",
    "test:perimeter": "node --experimental-strip-types src/rendering/floor-stack-3d/perimeter.check.ts",
    "test:editor": "node --experimental-strip-types src/domain/editor.check.ts",
    "test:e2e": "python e2e/smoke.py"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0"
  }
}
