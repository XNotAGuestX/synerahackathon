# Optional: required only for conversational /messages calls, not search or routes.
# ANTHROPIC_API_KEY=your-key-here

# Empty means an open local demo. Set a token to require Authorization: Bearer ...
API_TOKEN=

# Browser origins, comma-separated. No cookies are used.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional: spoken replies and voice input (ElevenLabs). Unset: voice endpoints answer 503 40004_speech_unavailable.
# ELEVENLABS_API_KEY=your-key-here
# Voice used for spoken replies (default: a public premade voice).
# ELEVENLABS_VOICE_ID=
# Text-to-speech model (default eleven_flash_v2_5).
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Speech-to-text model (default scribe_v2).
# ELEVENLABS_STT_MODEL=scribe_v2
