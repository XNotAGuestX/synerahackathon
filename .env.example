# Optional: required only for conversational /messages calls, not search or routes.
# ANTHROPIC_API_KEY=your-key-here

# Empty means an open local demo. Set a token to require Authorization: Bearer ...
API_TOKEN=

# Browser origins, comma-separated. No cookies are used.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
